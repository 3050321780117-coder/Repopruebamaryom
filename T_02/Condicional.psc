Proceso Condicional
	
    Definir x, valorY Como Entero
	
    x = 1
    valorY = 0
	
    Si x > valorY Entonces
		
        Escribir "x es mayor a y"
		
    Sino
		
        Si x = valorY Entonces
			
            Escribir "x y y son iguales"
			
        Sino
			
            Escribir "y es mayor a x"
			
        FinSi
		
    FinSi
	
FinProceso
