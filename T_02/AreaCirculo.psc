Proceso AreaCirculo
	
    //Definición de Variables
    Definir radio, area Como Real;
	
    //Entrada de Datos
    Escribir "Ingresa el radio del circulo";
    Leer radio;
	
    //Procesamiento
    area = 3.14 * radio * radio;
	
    //Salida de Resultados
    Escribir "El area del circulo es", area;
	
FinProceso