Proceso CondicionCompuesta
	
    Definir x, valorY, z Como Entero
	
    x = 1
    valorY = 0
    z = -5
	
    Si x > valorY Y z < 0 Entonces
		
        Escribir "x es mayor a y y z es menor a 0"
		
    Sino
		
        Si x = valorY O z < 0 Entonces
			
            Escribir "x y y son iguales"
			
        Sino
			
            Escribir "y es mayor a x"
			
        FinSi
		
    FinSi
	
FinProceso
